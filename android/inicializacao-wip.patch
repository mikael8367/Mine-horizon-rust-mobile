+/// Owns the platform input needed to create this run's one winit event loop.
+/// The Android entry point must supply the app received from android-activity.
+pub(crate) struct EventLoopSource {
+    #[cfg(target_os = "android")]
+    android_app: Option<winit::platform::android::activity::AndroidApp>,
+}
+
+impl EventLoopSource {
+    pub(crate) fn new() -> Self {
+        Self {
+            #[cfg(target_os = "android")]
+            android_app: None,
+        }
+    }
+
+    #[cfg(target_os = "android")]
+    pub(crate) fn with_android_app(app: winit::platform::android::activity::AndroidApp) -> Self {
+        Self {
+            android_app: Some(app),
+        }
+    }
+
+    /// Consuming the source prevents a second event loop for the same run.
+    fn build(self) -> Result<EventLoop<()>> {
+        #[cfg(target_os = "android")]
+        {
+            use winit::platform::android::EventLoopBuilderExtAndroid;
+            let app = self
+                .android_app
+                .ok_or("AndroidApp was not supplied by the Android entry point")?;
+            let mut builder = EventLoop::builder();
+            builder.with_android_app(app);
+            Ok(builder.build()?)
+        }
+        #[cfg(not(target_os = "android"))]
+        {
+            Ok(EventLoop::new()?)
+        }
+    }
+}
